                          <span className={`w-2 h-2 rounded-full ${isSelected ? 'bg-emerald-400' : 'bg-emerald-600'}`}></span>
                        )}
                      </div>
                    </button>
                  )
                })}
              </div>
            </div>
          </div>
        )}

        {/* =====================================================================
            TAB 5: กราฟเรดาร์ 6 เหลี่ยม & วิเคราะห์สรีระ 3D (EXECUTIVE ANALYTICS)
           ===================================================================== */}
