                🔥 1. โปรแกรมพิเศษ & ฮีโร่
              </button>
              <button onClick={() => setActiveTab('trail30')} className={`px-3.5 py-2 text-xs font-extrabold rounded-xl border transition ${activeTab === 'trail30' ? 'bg-emerald-700 text-white border-emerald-700 shadow-xs' : 'bg-white text-slate-700 border-slate-300'}`}>
                🏔️ 2. ภารกิจเดินป่า 30 อุทยานทั่วไทย
              </button>
              <button onClick={() => setActiveTab('custom_trainer')} className={`px-3.5 py-2 text-xs font-extrabold rounded-xl border transition ${activeTab === 'custom_trainer' ? 'bg-amber-500 text-slate-950 border-amber-500 shadow-xs' : 'bg-white text-slate-700 border-slate-300'}`}>
