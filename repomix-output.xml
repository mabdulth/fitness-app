            />
            <MealPlannerWidget
              profile={profile}
              activeBurnKcal={dailyMetrics.totalCalories}
              workoutMins={dailyMetrics.totalWorkoutMins}
            />
            <AnalyticsWidgets
              muscleActivationMatrix={muscleActivationMatrix}
              allHistoricalLogs={allHistoricalLogs}
              mode="nutrition"
