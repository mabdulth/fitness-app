// ============================================================================
// 7. TRAIL EXPEDITION READINESS & MUSCLE GAP EVALUATOR (ประเมินความพร้อมเดินป่า)
// ============================================================================
export function evaluateTrailExpeditionReadiness(park, profile, allHistoricalLogs = []) {
  if (!park) return null

  const now = new Date()
  const fourteenDaysAgo = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 14, 12, 0, 0)
  const cutoffIso = formatLocalISO(fourteenDaysAgo)

  // คำนวณสถิติการซ้อมในรอบ 14 วันล่าสุด (นำมาเฉลี่ยต่อสัปดาห์)
  const recentLogs = allHistoricalLogs.filter(l => l.date >= cutoffIso)

  const stats = recentLogs.reduce(
    (acc, l) => {
      const m = l.muscle_group || l.muscle
      const s = parseInt(l.sets) || 0
      const mins = parseFloat(l.duration_mins ?? l.duration) || 0
      if (m === 'Cardio') {
        return { ...acc, cardioMins: acc.cardioMins + mins }
      }
      return {
        ...acc,
        setsByMuscle: { ...acc.setsByMuscle, [m]: (acc.setsByMuscle[m] || 0) + s }
      }
    },
    { cardioMins: 0, setsByMuscle: {} }
  )

  // โบนัสพื้นฐานจากระดับความฟิตในโปรไฟล์ (เพื่อให้คนที่มีพื้นฐานไม่เริ่มต้นที่ 0% จนท้อ)
  const level = profile?.fitness_level || 'Intermediate'
  const baseCreditSets = level === 'Advanced' ? 6 : level === 'Intermediate' ? 4 : 2
  const baseCreditCardio = level === 'Advanced' ? 35 : level === 'Intermediate' ? 20 : 10

  const effectiveLegSets = Math.round(((stats.setsByMuscle.Legs || 0) / 1.5) + baseCreditSets)
  const effectiveBackSets = Math.round((((stats.setsByMuscle.Back || 0) + (stats.setsByMuscle.Shoulders || 0) * 0.5) / 1.5) + baseCreditSets * 0.7)
  const effectiveCoreSets = Math.round(((stats.setsByMuscle.Core || 0) / 1.5) + baseCreditSets * 0.6)
  const effectiveCardioMins = Math.round((stats.cardioMins / 1.5) + baseCreditCardio)

  const req = park.reqSets || { Legs: 12, Back: 8, Core: 6, CardioMins: 75 }

  const legPct = Math.min(100, Math.round((effectiveLegSets / req.Legs) * 100))
  const backPct = Math.min(100, Math.round((effectiveBackSets / req.Back) * 100))
  const corePct = Math.min(100, Math.round((effectiveCoreSets / req.Core) * 100))
  const cardioPct = Math.min(100, Math.round((effectiveCardioMins / req.CardioMins) * 100))

  // น้ำหนักคะแนน: ขา 40%, คาร์ดิโอเดินชัน 30%, หลัง/บ่าแบกเป้ 15%, แกนกลางลำตัว 15%
  const overallReadyPct = Math.min(
    100,
    Math.round(legPct * 0.40 + cardioPct * 0.30 + backPct * 0.15 + corePct * 0.15)
  )
  const remainingGapPct = Math.max(0, 100 - overallReadyPct)

  const breakdownBars = [
    {
      key: 'Legs',
      label: '1. กำลังต้นขา เข่า และน่อง (Leg & Knee Climb Power)',
      current: effectiveLegSets,
      target: req.Legs,
      unit: 'เซ็ต/สัปดาห์',
      pct: legPct,
      missing: Math.max(0, req.Legs - effectiveLegSets),
      advice: 'ฝึก Squat, Bulgarian Split Squat และเขย่งน่องเพื่อรับแรงกระแทกขาลงเขา'
    },
    {
      key: 'Cardio',
      label: '2. ความทนทานปอดและหัวใจบนทางชัน (Incline Stamina)',
      current: effectiveCardioMins,
      target: req.CardioMins,
      unit: 'นาที/สัปดาห์',
      pct: cardioPct,
      missing: Math.max(0, req.CardioMins - effectiveCardioMins),
      advice: `ฝึกเดินชันลู่วิ่งที่ความชัน ~${park.avgInclinePct}% คุมโซนหัวใจ Zone 2`
    },
    {
      key: 'Back',
      label: '3. แผ่นหลังและบ่ารับน้ำหนักเป้ (Rucksack Posture Armor)',
      current: effectiveBackSets,
      target: req.Back,
      unit: 'เซ็ต/สัปดาห์',
      pct: backPct,
      missing: Math.max(0, req.Back - effectiveBackSets),
      advice: 'ฝึกท่าดึงหลัง (Row / Pulldown) และยักไหล่ (Shrugs) เพื่อสะพายเป้ไม่ปวดบ่า'
    },
    {
      key: 'Core',
      label: '4. แกนกลางลำตัวทรงตัวบนรากไม้/หินลื่น (Core Balance)',
      current: effectiveCoreSets,
      target: req.Core,
      unit: 'เซ็ต/สัปดาห์',
      pct: corePct,
      missing: Math.max(0, req.Core - effectiveCoreSets),
      advice: 'ฝึก Plank และ Hanging Leg Raise เพื่อพยุงกระดูกสันหลัง'
    }
  ]

  const weakMuscles = breakdownBars.filter(b => b.pct < 80)

  return {
    overallReadyPct,
    remainingGapPct,
    isReady: overallReadyPct >= 80,
    breakdownBars,
    weakMuscles
  }
}
