        )}

      </div>

      {/* Bottom Floating Navigation Dock สำหรับมือถือ (สะดวก ไม่ต้องเลื่อนขึ้นไปกดด้านบน) */}
      <div className="fixed bottom-0 left-0 right-0 z-30 bg-slate-950/95 border-t border-emerald-900/60 backdrop-blur-md px-4 py-2 sm:hidden">
