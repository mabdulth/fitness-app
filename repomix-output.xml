          now.getMonth(),
          now.getDate() - (13 - idx),
          12, 0, 0
        )
        const iso = formatLocalISO(d)
        return {
          date: iso,
          dayName: d.toLocaleDateString('th-TH', { weekday: 'short' }),
          dayNum: d.getDate(),
          monthShort: d.toLocaleDateString('th-TH', { month: 'short' })
        }
