              onClick={() => setShowVector(false)}
              className="absolute top-1.5 right-1.5 px-2 py-0.5 text-[9px] font-black text-amber-300 bg-slate-900 border border-amber-500/40 rounded-md hover:bg-slate-800 z-10"
