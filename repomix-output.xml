              </button>
              <button onClick={() => setActiveTab('science')} className={`px-3.5 py-2 text-xs font-extrabold rounded-xl border transition ${activeTab === 'science' ? 'bg-slate-900 text-white border-slate-900 shadow-xs' : 'bg-white text-slate-700 border-slate-300'}`}>
