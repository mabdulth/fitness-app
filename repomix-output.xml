  { id: 'All', label: 'ทุกอุปกรณ์' },
  { id: 'Dumbbell', label: 'ดัมเบล (Dumbbell)' },
  { id: 'Barbell', label: 'บาร์เบล (Barbell)' },
  { id: 'Machine', label: 'แมชชีน (Machine)' },
  { id: 'Cable', label: 'เคเบิล (Cable)' },
