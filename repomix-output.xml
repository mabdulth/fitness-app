    const { items: strengthItems } = defaultRecipe.reduce(
      (acc, step) => {
        const candidates = filterAndAdaptExercise(step.muscle, step.keyword, effectiveProfile)
        const picked = candidates.find(c => !acc.seen.has(c.name)) || candidates[0]
        if (picked && !acc.seen.has(picked.name)) {
          const nextSeen = new Set(acc.seen)
          nextSeen.add(picked.name)
          return { seen: nextSeen, items: [...acc.items, { ...picked, sets: step.sets, reps: step.reps, uuid: crypto.randomUUID() }] }
        }
        return acc
      },
      { seen: new Set(), items: [] }
    )

    const cardioBase = MASTER_EXERCISE_LIBRARY.find(e => e.name.includes('Incline Walk')) || MASTER_EXERCISE_LIBRARY.find(e => e.muscle === 'Cardio')
    const dur = park.difficulty === 'Advanced' ? 40 : park.difficulty === 'Intermediate' ? 30 : 25
    const inc = park.avgInclinePct || 8.0
    const spd = inc >= 10 ? 3.1 : 3.5
    const dist = park.distanceKm || Number(((dur / 60) * spd).toFixed(2))

    const cardioItem = {
      ...cardioBase, uuid: crypto.randomUUID(), sets: 1, reps: 1, weight: 0,
      duration: dur, incline: inc, speed_kmh: spd, distance_km: dist,
      notes: `จำลองเดินป่า: ${park.name} (ชัน ${inc}% • ระยะซ้อม ${dist} กม.)`
    }
    return [...strengthItems, cardioItem]
  }

  const buildTrainerCustomExercises = (prog) => {
    const rawList = Array.isArray(prog.exercises) ? prog.exercises : []
    return rawList.map(entry => {
      const matchedLib = MASTER_EXERCISE_LIBRARY.find(e => e.name === entry.name) || MASTER_EXERCISE_LIBRARY[0]
      const personalized = personalizeExercisePrescription(matchedLib, profile?.weight_kg || 70, profile?.fitness_level || 'Intermediate', profile?.session_mins || 60, userGoal, [], profile)
      return {
        ...personalized, sets: parseInt(entry.sets) || personalized.sets, reps: parseInt(entry.reps) || personalized.reps,
        duration: parseInt(entry.duration) || personalized.duration || 25, incline: parseFloat(entry.incline) || personalized.incline || 7.5,
        uuid: crypto.randomUUID(), notes: `โปรแกรมโดย ${prog.creator_name} (${prog.team_name} ${prog.team_icon || ''})`
