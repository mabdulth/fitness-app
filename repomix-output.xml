  const uniqueTeams = Array.from(new Set(trainees.map(t => t.team_name || 'ทีมขนุน')))
  const filteredTraineesList = trainees.filter(
    t => teamFilter === 'All' || (t.team_name || 'ทีมขนุน') === teamFilter
