    { name: MASTER_EXERCISE_LIBRARY[0].name, sets: 4, reps: 12 },
    { name: MASTER_EXERCISE_LIBRARY[15].name, sets: 4, reps: 12 },
    { name: MASTER_EXERCISE_LIBRARY[29].name, sets: 4, reps: 12 }
  ])
